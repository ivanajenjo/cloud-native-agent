<?xml version="1.0" encoding="UTF-8"?>
<!-- Agent Maven settings: cache in the volume and egress only through edge (ADR-0004). -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <localRepository>/data/cache/maven</localRepository>

  <proxies>
    <proxy>
      <id>edge-http</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>edge</host>
      <port>3128</port>
      <nonProxyHosts>localhost|127.0.0.1|edge</nonProxyHosts>
    </proxy>
    <proxy>
      <id>edge-https</id>
      <active>true</active>
      <protocol>https</protocol>
      <host>edge</host>
      <port>3128</port>
      <nonProxyHosts>localhost|127.0.0.1|edge</nonProxyHosts>
    </proxy>
  </proxies>
</settings>
