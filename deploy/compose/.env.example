# Copy to deploy/compose/.env and fill in. Do not commit the real .env.

# Edge API token (Bearer). Generate with: openssl rand -hex 32
AGENT_API_TOKEN=

# Address where edge publishes port 8080. 127.0.0.1 = this machine only; 0.0.0.0 for the LAN.
CNA_PUBLISH_ADDR=127.0.0.1

# How long edge waits for an answer to a network question before denying it (milliseconds,
# 1000-3600000). Default 120000 (2 minutes); no answer or no active session means deny.
# EDGE_ASK_TIMEOUT_MS=120000

# Only passed to the agent container (empty if not filled in).
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CNA_GIT_USER_NAME=
CNA_GIT_USER_EMAIL=

# Optional services (ADR-0009), referenced as $VARIABLE from config/notifications.yaml and
# config/web.yaml. Only passed to the agent container.
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
BRAVE_API_KEY=
TAVILY_API_KEY=

# SearXNG (profile "search"). Generate with: openssl rand -hex 32
SEARXNG_SECRET=
