{
  "name": "cloud-native-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/gateway",
    "packages/edge",
    "packages/extensions"
  ],
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pretest": "npm run build -w @cna/shared",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
