{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["development"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "packages/web/vite.config.ts"
  ],
  "exclude": ["packages/web/src/**", "packages/web/test/**"]
}
